APP_NAME="Candid Security"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.candidbahamas.com
APP_TIMEZONE=America/Nassau
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# One-time web installer (only needed if you have no SSH). Remove after setup.
SETUP_TOKEN=

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u000000000_candid
DB_USERNAME=u000000000_candid
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Hostinger mailbox (hPanel → Emails).
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=careers@candidbahamas.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=careers@candidbahamas.com
MAIL_FROM_NAME="${APP_NAME}"

# Office phones, addresses and emails are edited in Admin → Office settings, not here.
# true on a temporary preview domain: banner + noindex. Set false when the site replaces candidbahamas.com.
CANDID_PREVIEW=false
# Who is emailed about new applications, quotes and pickup requests (comma separated).
CANDID_NOTIFY_EMAIL=hr@candidbahamas.net,president@candidbahamas.net
